@page
@model CitySalon.Pages.Register.RegisterPageModel

@{
    ViewData["Title"] = "Opret bruger";
}

<link rel="stylesheet" href="~/css/register.css" />

<div class="register-page">

    <div class="register-card">

        <h1>Opret konto</h1>

        <p>Opret en bruger for at booke tider online.</p>

        <!-- Formularen sendes til OnPost() -->
        <form method="post">

            <!-- Viser alle fejlbeskeder samlet -->
            <div asp-validation-summary="All" class="text-danger"></div>

            <label>Navn</label>

            <!-- Binder inputfeltet til Customer.Name -->
            <input asp-for="Customer.Name" />

            <!-- Viser fejl for Customer.Name -->
            <span asp-validation-for="Customer.Name"
                  class="text-danger"></span>

            <label>Brugernavn</label>

            <input asp-for="Customer.UserName" />

            <span asp-validation-for="Customer.UserName"
                  class="text-danger"></span>

            <label>Email</label>

            <input asp-for="Customer.Email" />

            <span asp-validation-for="Customer.Email"
                  class="text-danger"></span>

            <label>Telefon</label>

            <input asp-for="Customer.Phone" />

            <span asp-validation-for="Customer.Phone"
                  class="text-danger"></span>

            <label>Kodeord</label>

            <input asp-for="Customer.Password"
                   type="password" />

            <span asp-validation-for="Customer.Password"
                  class="text-danger"></span>

            <!-- Sender formularen -->
            <button type="submit">
                Opret konto
            </button>

        </form>

        <!-- Link til login-side -->
        <p class="login-link">

            Har du allerede en konto?

            <a asp-page="/Login/LogInPage">
                Log ind her
            </a>

        </p>

    </div>

</div>

@section Scripts {

    <!-- Indlæser scripts til client-side validation -->
    <partial name="_ValidationScriptsPartial" />

}